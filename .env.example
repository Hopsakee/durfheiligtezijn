# Kopieer dit bestand naar `.env` (cp .env.example .env) en vul de twee waarden in.
# `.env` staat in .gitignore en komt dus nooit in git. Zet de sleutel nergens anders neer.
#
# Lokaal lees `python -m durfheilig.dev` dit bestand. Staat er niets in, dan gebruikt de app
# de vaste terugval (geen persoonlijke uitleg). Op de server komen dezelfde twee namen uit
# het env-bestand dat client-deploy.sh maakt, uit de `.env` van je laptop.

# Je Google AI-sleutel, aan te maken in Google AI Studio (aistudio.google.com, "Get API key").
# Stel daar de uitgavenlimiet in (afgesproken: 5 euro).
GEMINI_API_KEY=

# De naam van het Gemini-model dat de app aanroept, zoals Google AI Studio die noemt
# (bijvoorbeeld de naam van een Flash-model). Kies er één en gebruik dezelfde naam op de server.
GEMINI_MODEL=
