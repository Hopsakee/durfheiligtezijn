# Kopieer dit bestand naar `.env` (cp .env.example .env) en vul de twee waarden in.
# `.env` staat in .gitignore en komt dus nooit in git. Zet de sleutel nergens anders neer.
#
# Lokaal lees `python -m durfheilig.dev` dit bestand. Staat er niets in, dan gebruikt de app
# de vaste terugval (geen persoonlijke uitleg). Op de server komen dezelfde twee namen uit
# het env-bestand dat client-deploy.sh maakt, uit de `.env` van je laptop.

# Je Google AI-sleutel, aan te maken in Google AI Studio (aistudio.google.com, "Get API key").
# Stel daar de uitgavenlimiet in (afgesproken: 5 euro).
GEMINI_API_KEY=

# De naam van het Gemini-model dat de app aanroept, zoals Google AI Studio die noemt
# (bijvoorbeeld de naam van een Flash-model). Kies er één en gebruik dezelfde naam op de server.
GEMINI_MODEL=

# Optioneel: hoeveel seconden de app op Gemini wacht voordat hij de vaste tekst neemt (standaard 30).
# GEMINI_TIMEOUT=30

# Optioneel: hoeveel tokens het model mag "denken" voor het antwoordt. Standaard 0 (uit): veel sneller.
# Geeft jouw model een fout bij 0 (de log toont de HTTP-status), zet dan -1: het model beslist zelf.
# GEMINI_THINKING_BUDGET=0

# --- Een andere aanbieder: Scaleway, OVHcloud, Mistral of elke andere met een OpenAI-compatibele API ---
# Staan deze drie alle drie ingevuld, dan gaan ze voor op Gemini hierboven. Wil je het expliciet zeggen: LLM_PROVIDER=openai of gemini.
# LLM_PROVIDER=
# LLM_BASE_URL=       # het https-adres van de API tot en met /v1, zoals de aanbieder het geeft (bij Scaleway: de console)
# LLM_API_KEY=        # de sleutel van de aanbieder
# LLM_MODEL=          # de modelnaam zoals de aanbieder hem noemt
# LLM_TIMEOUT=30      # wachttijd in seconden
# LLM_JSON_MODUS=aan  # zet op "uit" als het model om een JSON-modus klaagt (de log toont de HTTP-status; de volledige melding zie je met curl)
