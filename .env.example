# Kopieer dit bestand naar `.env` (cp .env.example .env) en vul de twee waarden in.
# `.env` staat in .gitignore en komt dus nooit in git. Zet de sleutel nergens anders neer.
#
# Lokaal lees `python -m durfheilig.dev` dit bestand. Staat er niets in, dan gebruikt de app
# de vaste terugval (geen persoonlijke uitleg). Op de server komen dezelfde twee namen uit
# het env-bestand dat client-deploy.sh maakt, uit de `.env` van je laptop.

# Je Google AI-sleutel, aan te maken in Google AI Studio (aistudio.google.com, "Get API key").
# Stel daar de uitgavenlimiet in (afgesproken: 5 euro).
GEMINI_API_KEY=

# De naam van het Gemini-model dat de app aanroept, zoals Google AI Studio die noemt
# (bijvoorbeeld de naam van een Flash-model). Kies er één en gebruik dezelfde naam op de server.
GEMINI_MODEL=

# Optioneel: hoeveel seconden de app op Gemini wacht voordat hij de vaste tekst neemt (standaard 30).
# GEMINI_TIMEOUT=30

# Optioneel: hoeveel tokens het model mag "denken" voor het antwoordt. Standaard 0 (uit): veel sneller.
# Geeft jouw model een fout bij 0 (de log toont de HTTP-status), zet dan -1: het model beslist zelf.
# GEMINI_THINKING_BUDGET=0

# --- Andere aanbieders: Mistral, Scaleway, of elke andere met een OpenAI-compatibele API ---
# Meerdere sleutels mogen naast elkaar staan; de app gebruikt de aanbieder die LLM_PROVIDER noemt. Het modeltest-hulpprogramma
# (uv run python -m durfheilig.modeltest, zie de README) kiest per model een aanbieder met `scaleway:naam` of `mistral:naam`.
# MISTRAL_API_KEY=
# SCALEWAY_API_KEY=
#
# Welke aanbieder en welk model de app gebruikt: gemini, mistral, scaleway of openai (een andere, dan ook LLM_BASE_URL en LLM_API_KEY).
# LLM_PROVIDER=scaleway
# LLM_MODEL=mistral-small-3.2-24b-instruct-2506
#
# Voor `openai`: het https-adres van de API tot en met /v1 en de sleutel. Mistral en Scaleway kennen hun adres zelf: laat LLM_BASE_URL dan leeg, want een ander adres krijgt de sleutel van die aanbieder (de app waarschuwt).
# LLM_BASE_URL=
# LLM_API_KEY=
#
# De limieten van jouw account bij de aanbieder (zie hun console). De app blijft er zelf binnen: aanroepen wachten in de rij, en kan dat langer dan
# LLM_MAX_WACHT seconden duren, dan krijgt dat kind direct de vaste tekst. Mistral Experiment, volgens de console van Jelle: 20000 en 1.
# LLM_TOKENS_PER_MINUUT=20000
# LLM_VERZOEKEN_PER_SECONDE=1
# LLM_MAX_WACHT=10
#
# LLM_TIMEOUT=30      # wachttijd in seconden
# LLM_JSON_MODUS=aan  # zet op "uit" als het model om een JSON-modus klaagt (de log toont de HTTP-status; de volledige melding zie je met curl)
