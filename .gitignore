.sesskey

# --- Runtime data (SQLite lives on a Docker volume, never in git) ---
# Saints and question-bank JSON files ARE committed, so no blanket data/ rule.
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal

# --- Docker ---
docker-compose.override.yml

# --- Editors and OS ---
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
